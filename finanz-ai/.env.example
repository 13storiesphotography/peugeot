# Optional: Supabase Auth (dedicated Kontura project — not Peugeot)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway (Vercel) — without this, chat uses local affordability model
AI_GATEWAY_API_KEY=

# Encrypt finAPI user credentials at rest (min 16 chars). Required for live finAPI.
KONTURA_VAULT_KEY=

# finAPI Access + Web Form 2.0 (Sandbox first)
OPEN_BANKING_ENABLED=false
FINAPI_ENABLED=false
FINAPI_ENV=sandbox
FINAPI_CLIENT_ID=
FINAPI_CLIENT_SECRET=
FINAPI_CALLBACK_URL=http://localhost:3001/api/banking/callback

# Legacy aliases (optional)
OPEN_BANKING_PROVIDER=finapi
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
OPEN_BANKING_REDIRECT_URI=http://localhost:3001/api/banking/callback
