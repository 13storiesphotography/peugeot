# Supabase Auth (required for web login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: switch from demo vehicle to live stub when both are set
STELLANTIS_ACCESS_TOKEN=
STELLANTIS_VEHICLE_ID=

# Public registration (any Supabase user may sign in when true). Prefer false + ALLOWED_EMAILS for private apps.
PUBLIC_SIGNUP=false
# Also required in Supabase dashboard:
# Authentication → Providers → Email → Allow new users to sign up
# Authentication → URL Configuration → Site URL = https://www.peugeotcontrol.app
# Redirect URLs: https://www.peugeotcontrol.app/** and https://e3008-control.vercel.app/**

# Comma-separated owner emails (only used when PUBLIC_SIGNUP is not true)
ALLOWED_EMAILS=florian@tutzinger-knolls.de

# Server-side writes (Stripe webhook / Pro-Freischaltung)
SUPABASE_SERVICE_ROLE_KEY=

# Cron / background jobs (required, min 24 chars). Also set on Edge Function secrets.
CRON_SECRET=
# REQUIRED for encrypting MyPeugeot passwords + remote PIN at rest.
# Use a dedicated secret (not CRON_SECRET). If you previously encrypted with CRON_SECRET,
# set PEUGEOT_VAULT_KEY to that old value once, then rotate carefully.
PEUGEOT_VAULT_KEY=

# Optional third-party MyPeugeot OAuth helper. Credentials are POSTed to this URL.
# Leave unset to keep passwords on your server (local Puppeteer only).
# STELLOAUTH_URL=

# Extra allowed origins for auth/Stripe redirects (comma-separated), besides NEXT_PUBLIC_SITE_URL and VERCEL_URL.
# ALLOWED_SITE_ORIGINS=https://e3008-control.vercel.app

# Stripe Checkout (Pro 4,99 € / Monat · 39 € / Jahr). Test keys start with sk_test_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: fixed Price IDs from Stripe Dashboard (skips lookup_key auto-create)
# STRIPE_PRICE_PRO_MONTH=price_...
# STRIPE_PRICE_PRO_YEAR=price_...
NEXT_PUBLIC_SITE_URL=https://www.peugeotcontrol.app

# Optional SEO verification tokens (Search Console / Bing Webmaster)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Mail on every signup / signup problem. florian@tutzinger-knolls.de is always included.
# Extra addresses (comma-separated) go here; RESEND_API_KEY is required for e-mail alerts.
SIGNUP_NOTIFY_EMAIL=florian@tutzinger-knolls.de
RESEND_API_KEY=
# Verified Resend domain. Display name is always "Peugeot Control".
AUTH_EMAIL_FROM=Peugeot Control <noreply@peugeotcontrol.app>
# Auth Hook secret from Supabase → Authentication → Hooks → Send Email
# Hook URL: https://www.peugeotcontrol.app/api/auth/send-email
SEND_EMAIL_HOOK_SECRET=
# Optional push via ntfy.sh (phone alerts). Same topic receives signup + problems.
NTFY_TOPIC=
# Optional JSON webhook for signup / signup_failed / signup_abandoned
SIGNUP_NOTIFY_WEBHOOK=

# Public contact addresses (shown on Impressum / Datenschutz / AGB / Widerruf):
#   kontakt@peugeotcontrol.app      → general / Impressum
#   datenschutz@peugeotcontrol.app  → privacy
#   mail@peugeotcontrol.app         → legal / Widerruf
# Forward these to your private inbox (e.g. ImprovMX free + Vercel DNS MX):
#   MX 10 mx1.improvmx.com
#   MX 20 mx2.improvmx.com
# Then create the three aliases → mail@florianknoll.de (or your inbox).
# Do not publish personal addresses on the legal pages.
